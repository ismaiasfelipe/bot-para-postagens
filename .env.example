# Credenciais da API do Instagram (Meta for Developers)
# Copie este arquivo para ".env" e preencha com os valores reais --
# ".env" NUNCA deve ser commitado (ja esta no .gitignore).

# ID do app "IL Variedades Bot" (Meta for Developers > Detalhes do app)
IG_APP_ID=

# Chave secreta do app (mesma tela do IG_APP_ID, botao "Mostrar")
IG_APP_SECRET=

# ID da conta Business do Instagram (@ilvariedadesenxovais)
IG_USER_ID=

# Token de acesso gerado em "Configuracao da API com login do Instagram" > "Gerar token"
IG_ACCESS_TOKEN=

# Chave da API do Gemini (https://aistudio.google.com/apikey) -- usada por
# gerar_carrossel_gemini.py pra gerar/verificar as fotos dos produtos
GEMINI_API_KEY=

# Pra rodar em GitHub Actions: esses mesmos nomes viram Secrets do
# repositorio (Settings > Secrets and variables > Actions > New
# repository secret), nao esse arquivo .env -- ver README.md.
# credenciais_drive.json (chave de conta de servico do Google) vira o
# secret GOOGLE_SERVICE_ACCOUNT_JSON (conteudo do .json inteiro).
